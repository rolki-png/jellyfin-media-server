# Required base configuration
# Use an absolute host path where all media/config folders will live.
COMMON_PATH=/srv/media/isyrr
TZ=Etc/UTC

# Run LinuxServer.io containers as a non-root user.
# On Linux, use: id -u / id -g
PUID=1000
PGID=1000

# Optional: public URL Jellyfin advertises to clients (leave blank if unused).
# Example: http://192.168.1.10:8096
JELLYFIN_PUBLISHED_SERVER_URL=

# Optional service tuning
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
SEERR_LOG_LEVEL=debug

# Watchtower: automatic image pulls and container recreation (see README).
# Default poll interval is 6 hours (21600s) while the host is running.
# For a fixed daily time instead, set WATCHTOWER_SCHEDULE and remove
# WATCHTOWER_POLL_INTERVAL from the compose service (or leave unset).
# WATCHTOWER_POLL_INTERVAL=21600
# WATCHTOWER_SCHEDULE="0 0 4 * * *"
