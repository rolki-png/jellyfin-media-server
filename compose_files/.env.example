# Required base configuration
# Use an absolute host path where all media/config folders will live.
COMMON_PATH=/srv/media/isyrr
TZ=Etc/UTC

# Run LinuxServer.io containers as a non-root user.
# On Linux, use: id -u / id -g
PUID=1000
PGID=1000

# Optional service tuning
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
JELLYSEERR_LOG_LEVEL=debug

# Optional Plex claim token (leave empty if not needed)
PLEX_CLAIM=

# Watchtower: automatic image pulls and container recreation (see README).
# Cron is 6 fields: second minute hour day-of-month month day-of-week (TZ from TZ= above).
# Default in compose is 04:00 daily if unset.
# WATCHTOWER_SCHEDULE=0 0 4 * * *
