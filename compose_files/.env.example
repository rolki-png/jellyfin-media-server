# Required base configuration
# Use an absolute host path where all media/config folders will live.
COMMON_PATH=/srv/media/isyrr
TZ=Etc/UTC

# Physical mergerfs branch roots (used by same-disk-import.sh in Radarr/Sonarr).
# Defaults match the NVIDIA host layout; override if your pool differs.
# SAME_DISK_SSD_ROOT=/mnt/samsung-media/Isyrr
# SAME_DISK_HDD_ROOT=/mnt/4tb-media-2/Isyrr

# Run LinuxServer.io containers as a non-root user.
# On Linux, use: id -u / id -g
PUID=1000
PGID=1000

# Optional service tuning
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
SEERR_LOG_LEVEL=debug

# Optional compose profiles (Plex is the default streamer; Jellyfin/Prowlarr are parked).
# COMPOSE_PROFILES=jellyfin
# COMPOSE_PROFILES=prowlarr
# COMPOSE_PROFILES=jellyfin,prowlarr

# Plex: one-time claim token from https://plex.tv/claim (expires in ~4 minutes).
# PLEX_CLAIM=claim-xxxxxxxxxxxx
# LAN URL advertised to Plex clients (Xbox, TV apps):
# PLEX_ADVERTISE_IP=http://192.168.0.2:32400
# Hostname Radarr/Sonarr use to refresh Plex libraries (default: plex on the compose network).
# PLEX_INTERNAL_HOST=plex
# Local disk for Plex transcode temp files (do not use mergerfs/FUSE).
# PLEX_TRANSCODE_DIR=/var/lib/plex-transcode

# Watchtower (nickfedor/watchtower): pulls newer images for labeled containers.
# Default: poll every 6h while the host is on (reliable if the machine sleeps overnight).
# WATCHTOWER_POLL_INTERVAL=21600
# For a fixed daily time instead, set schedule and disable poll:
# WATCHTOWER_POLL_INTERVAL=
# WATCHTOWER_SCHEDULE="0 0 4 * * *"
# Cron is 6 fields: second minute hour day-of-month month day-of-week (TZ from TZ= above).
# Do not set both poll interval and schedule at once.
