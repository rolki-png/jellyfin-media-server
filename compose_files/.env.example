# Required base configuration
# Media + downloads on the mergerfs pool (hardlink-safe library/download view).
COMMON_PATH=/srv/media/isyrr
# SQLite app configs on a real local filesystem (SSD). Never mergerfs/FUSE.
# https://wiki.servarr.com/sonarr/faq#i-am-getting-an-error-database-disk-image-is-malformed
APPDATA_PATH=/srv/media/appdata
TZ=Etc/UTC

# Physical mergerfs branch roots (used by same-disk-import.sh in Radarr/Sonarr).
# Defaults match this host's mergerfs branches; override if your pool differs.
# SAME_DISK_SSD_ROOT=/mnt/samsung-media/Isyrr
# SAME_DISK_HDD_ROOT=/mnt/4tb-media-2/Isyrr

# Run LinuxServer.io containers as a non-root user.
# On Linux, use: id -u / id -g
PUID=1000
PGID=1000

# Optional service tuning
LOG_LEVEL=info
LOG_HTML=false
SEERR_LOG_LEVEL=debug

# Optional compose profiles (Plex is the default streamer; Jellyfin/Prowlarr are parked).
# COMPOSE_PROFILES=jellyfin
# COMPOSE_PROFILES=prowlarr
# COMPOSE_PROFILES=jellyfin,prowlarr

# Plex: one-time claim token from https://plex.tv/claim (expires in ~4 minutes).
# PLEX_CLAIM=claim-xxxxxxxxxxxx
# LAN URL advertised to Plex clients (Xbox, TV apps):
# PLEX_ADVERTISE_IP=http://192.168.0.236:32400
# Away from home: add the Tailscale address after `tailscale up` (tailscale ip -4).
# PLEX_ADVERTISE_IP=http://192.168.0.236:32400,http://100.x.y.z:32400
# Networks Plex treats as local. Replaces Plex's auto-detection, so list the home LAN too.
# PLEX_LAN_NETWORKS=192.168.0.0/24,100.64.0.0/10
# Hostname Radarr/Sonarr use to refresh Plex libraries (default: plex on the compose network).
# PLEX_INTERNAL_HOST=plex
# Local disk for Plex transcode temp files (do not use mergerfs/FUSE).
# PLEX_TRANSCODE_DIR=/var/lib/plex-transcode

# Watchtower (nickfedor/watchtower): reports newer images for labeled containers.
# Monitor-only by default; set WATCHTOWER_MONITOR_ONLY=false to auto-pull again.
# WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy.sh/<topic>?title=Image+updates
# Default: poll every 6h while the host is on (reliable if the machine sleeps overnight).
# WATCHTOWER_POLL_INTERVAL=21600
# For a fixed daily time instead, set schedule and disable poll:
# WATCHTOWER_POLL_INTERVAL=
# WATCHTOWER_SCHEDULE="0 0 4 * * *"
# Cron is 6 fields: second minute hour day-of-month month day-of-week (TZ from TZ= above).
# Do not set both poll interval and schedule at once.

# Recyclarr (TRaSH Guides sync). Image tag is :8 — Recyclarr no longer publishes :latest.
# RECYCLARR_CRON_SCHEDULE=@daily

# Tautulli → SIMKL (no Plex Pass). Copy the unique webhook URL after signing in:
# https://simkl.com/apps/plex
# Quote the value — the URL contains &.
# SIMKL_PLEX_WEBHOOK_URL='https://api.simkl.com/sync/plex/webhook?client_id=...&token=...'
# App keys from SIMKL developer settings (not used by the Tautulli webhook).
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=

# Homarr dashboard (http://localhost:7575), beside Panelarr (:8000).
# 64 hex characters. Generate with: openssl rand -hex 32
# Keep this value. It encrypts integration secrets stored in Homarr's database.
# HOMARR_SECRET_ENCRYPTION_KEY=

# Optional Freeloader hook trace (empty disables). Writable path inside the plex container.
# PLEX_TRAFFIC_LOG=/config/freeloader-traffic.log

# Health alerts from media-monitor.timer (stack-monitor.py). Subscribe in the ntfy app.
# Pick an unguessable topic: echo media-$(openssl rand -hex 8)
# NTFY_URL=https://ntfy.sh/<topic>

# Nightly appdata backup (media-backup.timer → backup-appdata.sh). Keep the repository on a
# different physical disk than APPDATA_PATH. Password file: root-only, outside the repo.
# RESTIC_REPOSITORY=/mnt/4tb-media-2/backups/appdata-restic
# RESTIC_PASSWORD_FILE=/etc/media-server/restic.pass

# Paperless-ngx document archive on :8010. PAPERLESS_URL is the URL you browse (tailnet name).
# Secret key: openssl rand -hex 32. Admin password: openssl rand -base64 18 | tr -d '/+='
# PAPERLESS_URL=http://media-server.<tailnet>.ts.net:8010
# PAPERLESS_EXTRA_ORIGINS=http://<tailscale-ip>:8010,http://<lan-ip>:8010
# PAPERLESS_SECRET_KEY=
# PAPERLESS_ADMIN_USER=admin
# PAPERLESS_ADMIN_PASSWORD=
# PAPERLESS_OCR_LANGUAGE=ron+hun+eng
# PAPERLESS_OCR_LANGUAGES="ron hun"
